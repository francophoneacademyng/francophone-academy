rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // FONCTIONS HELPER
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('superadmin');
    }

    function isStaff() {
      return isAdmin() || hasRole('teacher');
    }

    function isOwnerOrStaff(userId) {
      return isOwner(userId) || isStaff();
    }

    // ============================================
    // COLLECTION : users/{userId}
    // ============================================
    match /users/{userId} {
      allow read: if isOwnerOrStaff(userId);
      allow create: if isOwner(userId);
      // Le client ne peut modifier que ses propres champs non-sensibles
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'uid', 'createdAt', 'subscriptionPlan']);
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : student_progress/{userId}
    // ============================================
    // L'utilisateur peut lire, mais NE PEUT PAS modifier directement.
    // Seules les Cloud Functions mettent a jour les scores et XP.
    match /student_progress/{userId} {
      allow read: if isOwnerOrStaff(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : courses/{courseId}
    // ============================================
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ============================================
    // COLLECTION : modules/{moduleId}
    // ============================================
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ============================================
    // COLLECTION : lessons/{lessonId}
    // ============================================
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // ============================================
    // COLLECTION : enrollments/{enrollmentId}
    // ============================================
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Le client peut mettre a jour les lecons terminees, mais PAS le score final
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['finalScore', 'certificateIssued', 'progress', 'quizAverage']);
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : quizzes/{quizId}
    // ============================================
    match /quizzes/{quizId} {
      allow read: if isAuthenticated()
        && (resource.data.isPublished == true || resource.data.createdBy == request.auth.uid || isStaff());
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid || isStaff());
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : questions/{questionId}
    // ============================================
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid || isStaff());
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : quiz_attempts/{attemptId}
    // ============================================
    // L'utilisateur peut creer et lire ses tentatives, mais PAS modifier le statut ou le score.
    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Le client peut sauvegarder ses reponses, mais PAS modifier le score final
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['score', 'maxScore', 'percentage', 'isPassing', 'status']);
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : quiz_results/{resultId}
    // ============================================
    // IMMUABLE — Seules les Cloud Functions ecrivent.
    // Le client ne peut JAMAIS modifier un resultat.
    match /quiz_results/{resultId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create, update, delete: if false;
    }

    // ============================================
    // COLLECTION : student_scores/{userId}
    // ============================================
    // IMMUABLE cote client — Seules les Cloud Functions mettent a jour.
    match /student_scores/{userId} {
      allow read: if isOwnerOrStaff(userId);
      allow create, update, delete: if false;
    }

    // ============================================
    // COLLECTION : chat_sessions/{sessionId}
    // ============================================
    match /chat_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : chat_messages/{messageId}
    // ============================================
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : tutor_memory/{userId}
    // ============================================
    match /tutor_memory/{userId} {
      allow read: if isOwnerOrStaff(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isStaff();
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : subscriptions/{subId}
    // ============================================
    // Le client peut lire, mais la creation/modification passe par Cloud Functions.
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow delete: if isAdmin();
    }

    // ============================================
    // COLLECTION : payments/{paymentId}
    // ============================================
    // IMMUABLE — Seules les Cloud Functions ecrivent.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create, update, delete: if false;
    }

    // ============================================
    // COLLECTION : transactions/{txnId}
    // ============================================
    // IMMUABLE — Seules les Cloud Functions ecrivent.
    match /transactions/{txnId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create, update, delete: if false;
    }

    // ============================================
    // COLLECTION : invoices/{invoiceId}
    // ============================================
    // IMMUABLE — Seules les Cloud Functions ecrivent.
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isStaff()
      );
      allow create, update, delete: if false;
    }

    // ============================================
    // COLLECTION : certificates/{certId}
    // ============================================
    // Le client peut lire ses certificats actifs.
    // La creation/modification/revocation passe par Cloud Functions.
    match /certificates/{certId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
        || isStaff()
        || resource.data.status == 'active'
      );
      // Le client peut incrementer downloadCount (verifie cote serveur)
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['downloadCount', 'verificationCount', 'updatedAt']);
      allow create, delete: if false;
    }

    // ============================================
    // COLLECTION : certificate_templates/{templateId}
    // ============================================
    match /certificate_templates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // COLLECTION : notifications/{notifId}
    // ============================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ============================================
    // COLLECTION : logs/{logId}
    // ============================================
    // Seuls les admins peuvent lire les logs.
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // REGLE PAR DEFAUT — DENY ALL
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
